# Android build configuration only. Web uses config.js (see README).
# Never add broker tokens or service_role keys to this file.
# GEMINI_API_KEY: Required for Gemini AI API calls.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Optional Supabase and Market Data integrations
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Alpha Vantage / Financial Data Provider API key (optional, free tier or demo fallback)
ALPHA_VANTAGE_API_KEY=demo

